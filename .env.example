# =====================================================================
# .env.example · variables de entorno de PUERTITA
# ---------------------------------------------------------------------
# Copiar a `.env.local` (gitignored) y completar con valores reales.
# NUNCA commitear `.env.local` ni secrets reales.
# =====================================================================

# Supabase (cliente browser + server) · la anon key es pública (protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Pendiente TASK-002+ (NO usar en cliente · solo Edge Functions / server):
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# TEST_DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/<db>   # CI e2e/sql · TASK-002
